    "edit_post": { "method": "PATCH", "path": "/posts/{post_id}" },
    "like_post": { "method": "PATCH", "path": "/posts/{post_id}/like" },
    "get_comments": { "method": "GET", "path": "/posts/{post_id}/comments" },
    "upload_comment": { "method": "POST", "path": "/posts/{post_id}/comment" }
  },
  "comments": {
    "get_comment": { "method": "GET", "path": "/comments/{comment_id}" },
    "delete_comment": { "method": "DELETE", "path": "/comments/{comment_id}" },
    "like_comment": { "method": "PATCH", "path": "/comments/{comment_id}/like" }
