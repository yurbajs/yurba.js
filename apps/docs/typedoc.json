{
  "name": "Yurba.js",
  "entryPointStrategy": "packages",
  "entryPoints": [
    "../../packages/*"
  ],
  "out": "./dist",
  "docsRoot": "dist",
  "json": "./public/docs.json",
  "theme": "default",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "hideGenerator": true,
  "readme": "../../README.md",
  "categorizeByGroup": true,
  "defaultCategory": "None",
  "gitRevision": "main",
  "sourceLinkTemplate": "https://github.com/yurbajs/yurba.js/blob/main/{path}#L{line}",
  "cleanOutputDir": false,
  "treatWarningsAsErrors": false,
  "logLevel": "Error",
  "navigationJson": "./navigation.json",
  "validation": {
    "notExported": false,
    "invalidLink": false,
    "notDocumented": false
  },
  "plugin": [
    "typedoc-plugin-markdown",
    "./typedoc-plugins.js",
    "typedoc-vitepress-theme"
  ],
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "entryFileName": "index.md",
  "sidebar": {
    "autoConfiguration": true,
    "format": "vitepress",
    "pretty": true,
    "collapsed": true
  },
  "skipErrorChecking": false,
  "navigationLinks": {
    "Guide": "https://yurba.js.org",
    "GitHub": "https://github.com/RastGame/Yurba.js",
    "npm": "https://www.npmjs.com/package/yurba.js"
  },
  "visibilityFilters": {
    "protected": true,
    "private": true,
    "inherited": true,
    "external": true
  },
  "searchInComments": true,
  "disableSources": true,
  "excludeNotDocumentedKinds": [
    "Module",
    "Namespace",
    "Enum",
    "Variable",
    "Function",
    "Class",
    "Interface",
    "Constructor",
    "Property",
    "Method",
    "CallSignature",
    "IndexSignature",
    "ConstructorSignature",
    "Accessor",
    "GetSignature",
    "SetSignature",
    "TypeAlias",
    "Reference"
  ]
}