{
  "name": "Yurba.js",
  "entryPointStrategy": "packages",
  "entryPoints": [
    "../../packages/*"
  ],
  "out": "./docs",
  "theme": "default",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "hideGenerator": true,
  "readme": "../../README.md",
  "categorizeByGroup": true,
  "sort": ["alphabetical"],
  "gitRevision": "main",
  "sourceLinkTemplate": "https://github.com/yurbajs/yurba.js/blob/main/{path}#L{line}",
  "cleanOutputDir": true,
  "treatWarningsAsErrors": false,
  "favicon": "https://yurba.js.org/logo.png",
  "validation": {
    "notExported": false,
    "invalidLink": false,
    "notDocumented": false
  },
  "plugin": ["typedoc-plugin-markdown"],
  "hidePageHeader": true,
  "entryFileName": "index.md",
  "docsRoot": "./",
  "skipErrorChecking": true,
  "navigationLinks": {
    "Guide": "https://yurba.js.org",
    "GitHub": "https://github.com/RastGame/Yurba.js",
    "npm": "https://www.npmjs.com/package/yurba.js"
  },
  "visibilityFilters": {
    "protected": false,
    "private": false,
    "inherited": true,
    "external": false
  },
  "searchInComments": true,
  "disableSources": false,
  "lightHighlightTheme": "github-light",
  "darkHighlightTheme": "github-dark",
  "useCodeBlocks": true,
  "blockTags": [
    "@alpha",
    "@beta",
    "@defaultValue",
    "@decorator",
    "@deprecated",
    "@eventProperty",
    "@example",
    "@experimental",
    "@inheritDoc",
    "@internal",
    "@label",
    "@override",
    "@packageDocumentation",
    "@param",
    "@privateRemarks",
    "@public",
    "@readonly",
    "@remarks",
    "@returns",
    "@sealed",
    "@see",
    "@since",
    "@throws",
    "@typeParam",
    "@virtual"
  ]
}