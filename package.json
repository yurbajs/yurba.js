{
  "name": "@yurbajs/yurba.js",
  "version": "0.0.0",
  "author": "RastGame",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "install:all": "pnpm install",
    "clean": "turbo run clean",
    "reset": "pnpm run clean && rm -rf node_modules packages/*/node_modules && pnpm install",
    "lint": "turbo run lint",
    "lint:fix": "lerna run lint -- --fix",
    "format": "eslint . --ext .ts,.js --fix",
    "format:check": "eslint . --ext .ts,.js",
    "test": "turbo run test",
    "test:local": "pnpm run build:local && pnpm run test",
    "build": "turbo run build",
    "build:local": "pnpm run clean && pnpm run build",
    "dev": "lerna run build --watch",
    "all": "pnpm run lint && pnpm run test && pnpm run build",
    "docs": "pnpm run docs:clean && pnpm run build && cd apps/docs && pnpm run docs",
    "docs:local": "pnpm run docs:clean && cd apps/docs && pnpm run docs",
    "docs:dev": "cd apps/docs && pnpm run docs:dev",
    "docs:serve": "pnpm run docs && cd apps/docs && pnpm run docs:preview && node ./scripts/convert-links.js",
    "docs:clean": "rimraf apps/docs/.vitepress/dist apps/docs/api",
    "docs:watch": "typedoc --watch",
    "guide:dev": "vitepress dev apps/guide",
    "guide:build": "vitepress build apps/guide",
    "guide:preview": "vitepress preview apps/guide",
    "guide:start": "pnpm run guide:build && pnpm run guide:preview",
    "publish": "turbo run lint test clean build && lerna publish"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/events": "^3.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.16.4",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.2.0",
    "eslint": "^9.31.0",
    "events": "^3.3.0",
    "globals": "^15.15.0",
    "http-server": "^14.1.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lerna": "^7.4.2",
    "lint-staged": "^15.5.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.0",
    "tsup": "^8.5.1",
    "turbo": "^2.5.4",
    "type-coverage": "^2.29.7",
    "typedoc": "^0.28.7",
    "typedoc-plugin-md": "^0.7.1",
    "typedoc-theme-hierarchy": "^6.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vitepress": "^1.6.3",
    "ws": "^8.18.3"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "git add"
    ]
  },
  "dependencies": {
    "vue": "^3.5.26"
  }
}
