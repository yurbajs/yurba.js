{
  "version": "independent",
  "updateInternalDependencies": "none",
  "npmClient": "pnpm",
  "packages": [
    "packages/*"
  ],
  "ignoreChanges": [
    "**/*.md",
    "**/*.test.ts",
    "**/test/**"
  ],
  "command": {
    "version": {
      "conventionalCommits": true,
      "allowBranch": ["main", "dev"],
      "changelogPreset": {
        "name": "conventionalcommits",
        "types": {
          "feat": {
            "section": "Features",
            "bump": "minor"
          },
          "fix": {
            "section": "Bug Fixes",
            "bump": "patch"
          },
          "perf": {
            "section": "Performance Improvements",
            "bump": "patch"
          },
          "refactor": {
            "section": "Code Refactoring",
            "bump": "patch"
          }
        }
      },
      "exact": true
    },
    "publish": {
      "conventionalCommits": true,
      "message": "chore(release): publish",
      "registry": "https://registry.npmjs.org/"
    },
    "run": {
      "npmClient": "pnpm",
      "stream": true
    }
  }
} 