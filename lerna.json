{
  "version": "independent",
  "updateInternalDependencies": "none",
  "npmClient": "pnpm",
  "packages": [
    "packages/*"
  ],
  "ignoreChanges": [
    "**/*.md",
    "**/*.test.ts",
    "**/test/**"
  ],
  "command": {
    "version": {
      "conventionalCommits": true,
      "allowBranch": ["main", "dev"],
      "changelogPreset": {
        "name": "angular",
        "header": ""
      },
      "createRelease": "github",
      "changelog": true,
      "exact": true,
      "forcePublish": true
    },
    "publish": {
      "conventionalCommits": true,
      "message": "chore(release): publish",
      "registry": "https://registry.npmjs.org/",
      "skipNpm": false,
      "skipBump": true
    },
    "run": {
      "npmClient": "pnpm",
      "stream": true
    }
  }
} 