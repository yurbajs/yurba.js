{
  "bumpFiles": [
    {
      "filename": "package.json",
      "type": "json"
    }
  ],
  "types": {
    "feat": {
      "section": "Features",
      "bump": "minor"
    },
    "fix": {
      "section": "Bug Fixes",
      "bump": "patch"
    },
    "perf": {
      "section": "Performance Improvements",
      "bump": "patch"
    },
    "refactor": {
      "section": "Code Refactoring",
      "bump": "patch"
    },
    "chore": {
      "hidden": true
    },
    "docs": {
      "section": "Documentation",
      "bump": false
    },
    "style": {
      "hidden": true
    },
    "test": {
      "hidden": true
    }
  },
  "releaseCommitMessageFormat": "chore(release): {{currentTag}}",
  "issuePrefixes": ["#"]
}